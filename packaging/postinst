#!/bin/sh
set -e
case "$1" in
    configure)
        if ! getent passwd cf-ddns >/dev/null; then
            adduser --system --group --home /nonexistent --no-create-home \
                --disabled-login --quiet cf-ddns
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload
            # Preserve enabled state across upgrades, without enabling a new install.
            if systemctl is-enabled --quiet cf-ddns.timer; then
                systemctl restart cf-ddns.timer
            fi
        fi
        ;;
esac
exit 0
